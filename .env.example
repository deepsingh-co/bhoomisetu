# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# BHOOMISETU — ENTERPRISE INFRASTRUCTURE & BACKEND CONFIGURATION
# ==============================================================================
NODE_ENV="production"
PORT=3000

# PostgreSQL & PostGIS (MeghRaj NIC Cloud)
DATABASE_URL="postgresql://bhulekh_admin:SecurePass123!@localhost:5432/bhulekh_cadastre?schema=public&sslmode=prefer"
POSTGRES_USER="bhulekh_admin"
POSTGRES_PASSWORD="SecurePass123!"
POSTGRES_DB="bhulekh_cadastre"

# Redis & BullMQ Cache & Queue Cluster
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# AI Orchestration (Ollama / Local Inference & Groq Acceleration)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_AI_MODEL="llama3:8b"
SECONDARY_AI_MODEL="mistral:7b"
AI_EMBEDDING_MODEL="nomic-embed-text"
GROQ_API_KEY=""

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="national_cadastre_embeddings"

# S3 / MinIO Object Storage (Land records, GIS Shapefiles, Biometric hashes)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="bhulekh-cadastre-storage"
S3_REGION="ap-south-1"

# Security & RBAC Cryptography
JWT_SECRET="NIC_BHULEKH_AI_SUPER_SECRET_KEY_SHA256_2026"
JWT_EXPIRY="24h"
JWT_REFRESH_SECRET="NIC_BHULEKH_AI_REFRESH_SECRET_KEY_2026"
JWT_REFRESH_EXPIRY="7d"
CORS_ORIGIN="*"

# Monitoring & Telemetry
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOG_LEVEL="info"
ENABLE_AUDIT_LOG_CHAINING="true"
